VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Maytapi WhatsApp API Configuration
VITE_MAYTAPI_PRODUCT_ID=your-maytapi-product-id
VITE_MAYTAPI_PHONE_ID=your-phone-id
VITE_MAYTAPI_TOKEN=your-maytapi-token
VITE_WHATSAPP_DEFAULT_NUMBER=910000000000

# WhatsApp Test Mode:
# true  = Send ONLY to tester number; staff members will NOT receive messages
# false = Production mode; send to all staff members
VITE_WHATSAPP_TEST_MODE=false

# OpenAI API Configuration (Menu Chatbot)
VITE_OPENAI_API_KEY=your-openai-api-key
